# =============================================================================
# user-hub — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# Service
PORT=3001
NODE_ENV=development
SERVICE_NAME=user-hub
LOG_LEVEL=info

# PostgreSQL (user_management schema, userhub_app role)
DATABASE_URL=postgresql://userhub_app:userhub_dev_password@localhost:5432/brainwave?schema=user_management

# AuthHub gRPC (for internal ValidateToken calls)
AUTH_HUB_GRPC_HOST=localhost
AUTH_HUB_GRPC_PORT=50051
